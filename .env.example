# Copy this file to .env and fill in your real secrets.
# Do NOT commit .env to source control.

CME_LOGIN_USERNAME=
CME_LOGIN_PASSWORD=

EMAIL_SENDER=
EMAIL_PASSWORD=

EBAY_APP_ID=
EBAY_CERT_ID=

GOLD_API_KEY=
DATABENTO_API_KEY=
DB_API_KEY=
ALPHA_VANTAGE_KEY=
FRED_API_KEY=
UPLOAD_TOKEN=
EIA_API_KEY=
NTFY_URL=
DASHBOARD_URL=
REPORT_UPLOAD=

# Optional per-machine settings
# Data folder; leave empty to use ../CME_Data next to the project
PORTFOLIO_DATA_DIR=
# Port for options_whale/api_router.py (default 8080)
OPTIONS_WHALE_PORT=
# 1 only on the one machine that runs the weekday schedule (setup.sh --schedule sets it); empty = scheduled runs skip
SCHEDULED_RUNS=

# Delivery (leave empty to switch a channel off)
SMTP_SERVER=
SMTP_PORT=587
RECIPIENT_EMAIL=
# Address the reports are sent from, for scripts/import_email_positions.py (defaults to EMAIL_SENDER)
REPORT_SENDER=
# Upload receiver URL, see server/README.md
UPLOAD_URL=
