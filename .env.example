# Copy this file to .env (setup.sh does it for you) and fill in what you use. Never commit .env.
# Every setting is explained in docs/configuration.md.
#
# Rules: write values without quotes or trailing comments. An empty value means "not configured":
# the feature is skipped or the data source reports "missing", and the run continues. A number left empty
# (SMTP_PORT, OPTIONS_WHALE_PORT) uses its default. Flags that say "1" need exactly 1.

# --- Market data keys ---------------------------------------------------------------------------
# Databento: block trades for SPY and SLV. Empty: the flow sections report "missing".
# REQUIRED to start the terminal server (options_whale/api_router.py) and for setup.sh to start the login service.
# Fill this one, not DB_API_KEY.
DATABENTO_API_KEY=
# FRED: macro series (high-yield spread, repo, Fed balance sheet, yields, CPI dates).
# Empty: those series are missing and the VMRI shows INCOMPLETE DATA.
FRED_API_KEY=
# EIA API v2 for weekly energy data. Empty: the public EIA history file is used instead; nothing is lost.
EIA_API_KEY=
# SEC EDGAR contact string, "Your Name you@example.com". SEC asks automated clients to identify themselves. Only scripts/backfill_form4.py
# uses it. Empty: that script and the insider edge in the Edge Lab report "not configured".
SEC_USER_AGENT=
# News feed list (JSON: name, category, url, enabled). Empty: the bundled core/news_feeds.json.
NEWS_FEEDS_FILE=
# goldapi.io spot silver. Empty: spot silver and the futures-minus-spot basis are missing.
GOLD_API_KEY=
# eBay Browse API for Silver Eagle prices. Both are needed. Empty: the listings are missing.
EBAY_APP_ID=
EBAY_CERT_ID=
# Legacy name of DATABENTO_API_KEY. It is used only when DATABENTO_API_KEY is unset or blank, in every script.
# Prefer filling DATABENTO_API_KEY.
# DB_API_KEY=

# --- CME login ----------------------------------------------------------------------------------
# Only pre-fills the CME login page when a download needs a login; you still finish the login and MFA by hand.
# Empty: you type them in the browser window.
CME_LOGIN_USERNAME=
CME_LOGIN_PASSWORD=

# --- Email (the daily report) -------------------------------------------------------------------
# EMAIL_SENDER, EMAIL_PASSWORD, SMTP_SERVER and RECIPIENT_EMAIL are all needed to send. All four empty: email
# is skipped (not a warning). Some set and some empty: the send fails and the run ends with a warning (exit
# code 3). The message is saved as email.eml either way. The connection uses STARTTLS, so use port 587.
EMAIL_SENDER=
EMAIL_PASSWORD=
SMTP_SERVER=
# Empty: 587.
SMTP_PORT=587
RECIPIENT_EMAIL=
# IMAP server of the EMAIL_SENDER mailbox (port 993, same login). Each delivering run reads bounce notices there, so a
# report the recipient's server rejected is marked `bounced` and the phone push says so. Empty: SMTP_SERVER.
IMAP_SERVER=
# Address the report emails were sent from. Only scripts/import_email_positions.py uses it. Empty: EMAIL_SENDER.
REPORT_SENDER=

# --- Phone push and dashboard link --------------------------------------------------------------
# Full ntfy topic URL, for example https://ntfy.sh/your-topic. Treat it as a secret.
# Empty: no phone pushes (daily brief, refinery outage alerts, CME login alert); they are recorded as skipped.
NTFY_URL=
# Address of your terminal as your phone reaches it. Adds a "Dashboard" button to the daily push.
# Empty: no button.
DASHBOARD_URL=

# --- Upload to your own web server (see server/README.md) ---------------------------------------
# Receiver address, for example https://example.com/admin/data/upload_receiver.php
# UPLOAD_URL and UPLOAD_TOKEN must both be set for any upload. Both empty: nothing is uploaded (skipped).
# Only one of them set: the upload fails and the run ends with a warning.
UPLOAD_URL=
# Must equal the token stored on the server in /etc/portfolio-upload/token.
UPLOAD_TOKEN=
# Set to exactly 1 to also upload the daily report and put a permanent "Full report" link in the push.
# Empty: the report is not uploaded.
REPORT_UPLOAD=

# --- Per-machine settings -----------------------------------------------------------------------
# Data folder. Empty: CME_Data inside the project folder (git-ignored), or an existing ../CME_Data next to it
# (see docs/configuration.md); the first `main_pipeline.py run` creates the default folder. A folder named here is
# never created for you. Set it when more than one copy could exist.
PORTFOLIO_DATA_DIR=
# Port of the terminal (options_whale/api_router.py). Empty: 8080. Write it without quotes: setup.sh and the
# menu bar plugin read this line with sed.
OPTIONS_WHALE_PORT=
# Set to exactly 1 only on the one Mac that runs the weekday schedule (setup.sh --schedule sets it).
# Empty: runs started with --trigger scheduled are skipped. Manual runs always work.
SCHEDULED_RUNS=

# --- Standalone tools ---------------------------------------------------------------------------
# AlphaFlow (alphaflow/server.py): set to exactly 1 for Flask debug mode, which also limits it to this Mac.
# Empty: debug off.
# ALPHAFLOW_DEBUG=

# Console engine v3 (all optional): a model on this machine answers questions from the terminal's read-only APIs.
# Any OpenAI-compatible endpoint. Default is Ollama on this machine with qwen3.6:35b-a3b.
# Leaving ASSISTANT_LOCAL_URL empty also skips the pipeline's Briefing stage (the analyst note in the email); set it to turn that stage on.
ASSISTANT_LOCAL_URL=
ASSISTANT_LOCAL_MODEL=
# auto | none | low | medium | high. Default auto: no deliberate reasoning to route or answer from the brief, brief reasoning over fetched data.
ASSISTANT_LOCAL_REASONING=
ASSISTANT_LOCAL_API_KEY=
# Per question time limit in seconds (default 150) and per data source size in characters (default 12000).
# A server that reads prompts slowly (oMLX with a 27B model shared with a coding agent) wants more time and smaller sources.
ASSISTANT_MAX_SECONDS=
ASSISTANT_MAX_CHARS=

# --- SnapTrade (optional; Brokerage Positions card) -------------------------------------------------
# Both are needed (Personal keys; no user id or secret). Empty: the card shows the setup steps. See docs/configuration.md. May live in the Keychain instead.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# --- MCP server (optional; mcp_server.py, for Claude chat / ChatGPT) ------------------------------------
# Each token is the secret path of one endpoint (24+ random characters: openssl rand -hex 24). Blank: that endpoint is off.
# Market token: market data only. Brokerage token: your SnapTrade holdings. Keep them different.
MCP_MARKET_TOKEN=
MCP_BROKERAGE_TOKEN=
MCP_PORT=
# Where mcp_server.py finds the terminal. Empty: http://127.0.0.1:<OPTIONS_WHALE_PORT>.
TERMINAL_URL=
